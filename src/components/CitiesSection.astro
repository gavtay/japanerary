---
const { title, img, imgalt } = Astro.props;
---

<div class="lg:flex my-24">
    <div class="lg:w-1/2">
        <div class="flex justify-center">
            <img class="h-3/4 w-3/4" src=`${ img }` alt=`${ imgalt }`>
        </div>
    </div>
    <div class="lg:w-1/2 my-6 lg:my-0">
        <h2 class="text-3xl mb-3">{ title }</h2>
        <div class="w-3/4">
            <slot />
        </div>
    </div>
</div>